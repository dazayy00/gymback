generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
}

model User {
  id            Int      @id @default(autoincrement())
  name          String
  email         String?  @unique
  phone         String?
  qrCode        String   @unique
  imageUrl      String?
  status        UserStatus @default(ACTIVE)

  memberships   Membership[]
  sales         Sale[]
  accessLogs    AccessLog[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Membership {
  id         Int      @id @default(autoincrement())
  userId     Int
  type       MembershipType
  startDate  DateTime
  endDate    DateTime
  status     MembershipStatus @default(ACTIVE)

  user       User     @relation(fields: [userId], references: [id])

  createdAt  DateTime @default(now())
}

model Product {
  id          Int          @id @default(autoincrement())
  name        String
  description String?
  price       Float
  stock       Int          @default(0)
  barcode     String?      @unique
  imageUrl    String?
  isActive    Boolean      @default(true)

  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  saleDetails SaleDetail[]
}

model Sale {
  id            Int           @id @default(autoincrement())
  userId        Int?
  adminId       Int?
  total         Float
  paymentMethod PaymentMethod @default(CASH)

  user          User?         @relation(fields: [userId], references: [id])
  admin         Admin?        @relation(fields: [adminId], references: [id])
  details   SaleDetail[]

  createdAt DateTime @default(now())
}

model SaleDetail {
  id        Int     @id @default(autoincrement())
  saleId    Int
  productId Int
  quantity  Int
  price     Float

  sale      Sale    @relation(fields: [saleId], references: [id])
  product   Product @relation(fields: [productId], references: [id])
}

model AccessLog {
  id        Int      @id @default(autoincrement())
  userId    Int
  success   Boolean
  message   String?

  user      User     @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
}

model Admin {
  id        Int     @id @default(autoincrement())
  name      String
  email     String  @unique
  password  String
  role      AdminRole @default(STAFF)

  sales     Sale[]
  cashSessionsOpened CashRegisterSession[] @relation("OpenedByAdmin")
  cashSessionsClosed CashRegisterSession[] @relation("ClosedByAdmin")

  createdAt DateTime @default(now())
}

model CashRegisterSession {
  id              Int       @id @default(autoincrement())
  openedAt        DateTime  @default(now())
  closedAt        DateTime?
  openedById      Int
  closedById      Int?
  startingBalance Float     @default(0)
  closingBalance  Float?
  status          CashRegisterStatus @default(OPEN)

  openedBy        Admin     @relation("OpenedByAdmin", fields: [openedById], references: [id])
  closedBy        Admin?    @relation("ClosedByAdmin", fields: [closedById], references: [id])
}

model Gym {
  id        Int     @id @default(1)
  name      String
  logoUrl   String?
  primaryColor String? @default("#22c55e")

  createdAt DateTime @default(now())
}

enum AdminRole {
  SUPERADMIN
  STAFF
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum MembershipStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

enum MembershipType {
  WEEKLY
  MONTHLY
  YEARLY
  DAILY
}

enum PaymentMethod {
  CASH
  CARD
  TRANSFER
}

enum CashRegisterStatus {
  OPEN
  CLOSED
}